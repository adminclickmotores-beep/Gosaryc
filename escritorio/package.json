{
  "name": "gosaryc-escritorio",
  "version": "1.5.4",
  "private": true,
  "description": "Gosaryc para escritorio: abre el panel y trae la API local de WhatsApp con agente multi-especialista 24/7 en bandeja del sistema (sesion permanente, inicio automatico) y la API local de impresion silenciosa integradas.",
  "author": "Gosaryc",
  "main": "main.cjs",
  "scripts": {
    "iniciar": "electron .",
    "start": "electron .",
    "icono": "electron generar-icono.cjs",
    "instalador:windows": "npm run icono && electron-builder --win --x64 --ia32",
    "instalador:mac": "npm run icono && electron-builder --mac",
    "instalador:linux": "npm run icono && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.gosaryc.escritorio",
    "productName": "Gosaryc",
    "artifactName": "Gosaryc-Setup-${arch}.${ext}",
    "directories": { "output": "instaladores" },
    "files": ["main.cjs", "preload.cjs", "package.json", "build/icon.png", "api-impresion/server.js", "api-impresion/package.json"],
    "extraResources": [
      { "from": "guia", "to": "guia" },
      {
        "from": "../whatsapp-local",
        "to": "whatsapp-local",
        "filter": ["**/*", "!.sesion/**", "!token.txt", "!lineas.json"]
      }
    ],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "mac": { "icon": "build/icon.png" },
    "linux": { "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Gosaryc",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    }
  }
}
