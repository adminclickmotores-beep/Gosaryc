{
  "name": "gosaryc-escritorio",
  "version": "1.0.0",
  "private": true,
  "description": "Gosaryc para escritorio: abre el panel y trae la API local de WhatsApp con el agente integrada.",
  "author": "Gosaryc",
  "main": "main.cjs",
  "scripts": {
    "iniciar": "electron .",
    "start": "electron .",
    "instalador:windows": "electron-builder --win",
    "instalador:mac": "electron-builder --mac",
    "instalador:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.gosaryc.escritorio",
    "productName": "Gosaryc",
    "directories": { "output": "instaladores" },
    "files": ["main.cjs", "preload.cjs", "package.json"],
    "extraResources": [
      {
        "from": "../whatsapp-local",
        "to": "whatsapp-local",
        "filter": ["**/*", "!.sesion/**", "!token.txt", "!lineas.json"]
      }
    ],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
