{
  "name": "gosaryc-escritorio",
  "version": "1.6.8",
  "private": true,
  "description": "Gosaryc para escritorio: abre el panel y trae la API local de WhatsApp con agente multi-especialista 24/7 en bandeja del sistema (sesion permanente, inicio automatico) y la API local de impresion silenciosa integradas.",
  "author": "Gosaryc",
  "main": "main.cjs",
  "scripts": {
    "iniciar": "electron .",
    "start": "electron .",
    "icono": "electron generar-icono.cjs",
    "instalador:windows": "npm run icono && electron-builder --win --x64 --ia32",
    "instalador:tienda": "npm run icono && electron-builder --win appx --x64",
    "instalador:mac": "npm run icono && electron-builder --mac",
    "instalador:linux": "npm run icono && electron-builder --linux --x64"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.gosaryc.escritorio",
    "productName": "Gosaryc",
    "artifactName": "Gosaryc-Setup-${arch}.${ext}",
    "directories": { "output": "instaladores" },
    "files": ["main.cjs", "preload.cjs", "package.json", "build/icon.png", "api-impresion/server.js", "api-impresion/package.json"],
    "extraResources": [
      { "from": "guia", "to": "guia" },
      {
        "from": "../whatsapp-local",
        "to": "whatsapp-local",
        "filter": ["**/*", "!.sesion/**", "!token.txt", "!lineas.json"]
      }
    ],
    "publish": [
      { "provider": "github", "owner": "gosaryc", "repo": "gosaryc", "releaseType": "release" }
    ],
    "win": {
      "target": ["nsis", "appx"],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "appx": {
      "applicationId": "GosarycERP",
      "identityName": "Gosaryc.GosarycERP",
      "publisher": "CN=Gosaryc",
      "publisherDisplayName": "Gosaryc",
      "displayName": "Gosaryc"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Gosaryc",
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "Gosaryc-Setup-${arch}.${ext}"
    },
    "mac": { "icon": "build/icon.png", "category": "public.app-category.business" },
    "linux": {
      "icon": "build/icon.png",
      "target": ["AppImage", "deb"],
      "category": "Office",
      "description": "Gosaryc: pedidos, inventario, caja, facturas y agente WhatsApp IA."
    },
    "deb": {
      "packageCategory": "utils"
    },
    "appImage": {
      "artifactName": "Gosaryc-Linux-${arch}.${ext}"
    }
  }
}
